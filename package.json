{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:server\" \"npm:client\"",
    "client": "vite --port=3000 --host=0.0.0.0",
    "server": "tsx watch server/index.ts",
    "build": "npm run fix:esbuild && vite build && npm run build:server",
    "build:server": "npm run fix:esbuild && node scripts/build-server.mjs",
    "fix:esbuild": "node scripts/fix-esbuild-perms.mjs",
    "postinstall": "node scripts/fix-esbuild-perms.mjs",
    "start": "node server.js",
    "preview": "vite preview",
    "clean": "node -e \"for (const d of ['dist','dist-server']) require('fs').rmSync(d,{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "test:mysql-json": "tsx scripts/test-mysql-json-bind.ts",
    "test:app-root": "tsx scripts/test-app-root.ts",
    "test:seo-static": "tsx scripts/test-seo-static-files.ts && tsx scripts/verify-sitemap-headers.ts",
    "test:routes": "tsx scripts/test-app-routes.ts",
    "test:mapper": "tsx scripts/test-clerk-mapper.ts",
    "test:entitlements": "tsx scripts/test-plan-entitlements.ts",
    "test:questions": "tsx scripts/test-questions-db.ts",
    "test:mocks": "tsx scripts/test-mocks-domain.ts",
    "test:weekly": "tsx scripts/test-weekly-mock-domain.ts",
    "test:security": "tsx scripts/verify-security-attempt-session.ts && tsx scripts/verify-security-policies.ts",
    "test:referrals": "tsx scripts/test-referrals-domain.ts && tsx scripts/test-referrals-repo.ts",
    "test:payments": "tsx scripts/test-payment-claims.ts",
    "test:support": "tsx scripts/test-support-issues.ts",
    "test:email-domains": "tsx scripts/test-email-domain-policy.ts",
    "test:formulas": "tsx scripts/test-formulas-import.ts",
    "test:notifications": "tsx scripts/test-notifications-sync.ts",
    "test:promos": "tsx scripts/test-promo-codes.ts",
    "test:notices": "tsx scripts/test-notices-domain.ts",
    "test:daily-quick": "tsx scripts/test-daily-quick-domain.ts",
    "db:seed": "tsx scripts/seed-questions.ts"
  },
  "main": "server.js",
  "dependencies": {
    "@clerk/backend": "^3.15.0",
    "@clerk/clerk-react": "^5.61.9",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "esbuild": "^0.28.1",
    "express": "^4.21.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "mysql2": "^3.23.2",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.4",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  },
  "overrides": {
    "esbuild": "$esbuild"
  }
}
