{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:server\" \"npm:client\"",
    "client": "vite --port=3000 --host=0.0.0.0",
    "server": "tsx watch server/index.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:mapper": "tsx scripts/test-clerk-mapper.ts",
    "test:questions": "tsx scripts/test-questions-db.ts",
    "test:mocks": "tsx scripts/test-mocks-domain.ts",
    "test:security": "tsx scripts/verify-security-attempt-session.ts && tsx scripts/verify-security-policies.ts",
    "db:seed": "tsx scripts/seed-questions.ts"
  },
  "dependencies": {
    "@clerk/backend": "^3.15.0",
    "@clerk/clerk-react": "^5.61.9",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "mysql2": "^3.23.2",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.4",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
