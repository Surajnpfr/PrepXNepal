# Gemini (optional AI features)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Clerk — publishable key is safe for the Vite client
# Production: use the key for the SAME Clerk instance as CLERK_SECRET_KEY.
# If the key uses a custom Frontend API host (e.g. clerk.yourdomain.com), that
# DNS CNAME must resolve to Clerk or Sign In will never open.
VITE_CLERK_PUBLISHABLE_KEY="pk_test_..."

# Clerk secret — server only (never expose to Vite client bundle)
CLERK_SECRET_KEY="sk_test_..."

# Comma-separated origins allowed when verifying session JWTs (recommended in prod)
# Example: https://prepxnepal.com,https://www.prepxnepal.com
# CLERK_AUTHORIZED_PARTIES="https://prepxnepal.com"

# Email domain policy (server). Disposable/temp inboxes blocked by default.
# EMAIL_BLOCK_DISPOSABLE=true
# Optional: only allow these domains (comma-separated). Leave unset for any non-disposable domain.
# EMAIL_ALLOWED_DOMAINS=gmail.com,yahoo.com,outlook.com,hotmail.com,icloud.com,proton.me
# Optional extra blocklist:
# EMAIL_BLOCKED_DOMAINS=spammycustom.xyz


# Local Clerk sync API (Express)
API_PORT=3001

# Hostinger / PaaS inject PORT automatically. Prefer that in production.
# PORT=3000

# Bind address: omit for auto (127.0.0.1 local, 0.0.0.0 when PORT/production).
# API_BIND_HOST=0.0.0.0

# Optional public site URL for canonical / Open Graph (HTTPS production origin)
# VITE_SITE_URL="https://prepxnepal.com"

# Optional host URL
APP_URL="http://localhost:3000"

# When sharing via Cloudflare quick tunnel, set the public hostname (no https://).
# Example: earth-blast-neon-consolidation.trycloudflare.com
# TUNNEL_HOST="earth-blast-neon-consolidation.trycloudflare.com"

# --- Questions database ---
# Local default: SQLite file at data/prepx-questions.sqlite (no Hostinger needed).
# Hostinger production: set DB_DRIVER=mysql and the credentials from hPanel → MySQL.
# DB_DRIVER=mysql
# DB_HOST=srv....hostinger.com
# DB_PORT=3306
# DB_USER=u...._prepx
# DB_PASSWORD=...
# DB_NAME=u...._prepx
# Optional SQLite path override:
# SQLITE_PATH=./data/prepx-questions.sqlite
